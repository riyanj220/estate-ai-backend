# Copy to .env.hosted (ignored by git) and fill in every <...>. See docs/real-services.md.
# Never commit or share .env.hosted. This file is the whole configuration of hosted mode.

# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=<random-at-least-32-characters>
FRONTEND_BASE_URL=http://localhost:3000

# --- Supabase database: dashboard > Connect > Session pooler (port 5432) ---
SUPABASE_PROJECT_REF=<project-ref>
POSTGRES_HOST=<aws-N-region.pooler.supabase.com>
POSTGRES_PORT=5432
POSTGRES_DB=postgres
DB_SCHEMA=estate
DB_SSLMODE=require
# For DB_SSLMODE=verify-full, the certificate downloaded from the database settings:
# DB_SSLROOTCERT=/absolute/path/to/prod-ca.crt

# Passwords YOU choose, one per role, at least 32 characters each:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MIGRATOR_PASSWORD=<random>
RUNTIME_PASSWORD=<random>
# Optional: only for deleting expired audit and moderation history. Leave empty to skip.
PURGE_PASSWORD=

# --- Supabase Storage: private bucket, dashboard > Storage > S3 settings ---
S3_ENDPOINT_URL=<https://project-ref.storage.supabase.co/storage/v1/s3>
S3_REGION=<region-shown-there>
S3_BUCKET=<bucket-name>
S3_ACCESS_KEY_ID=<access-key-id>
S3_SECRET_ACCESS_KEY=<secret-access-key>

# --- Real email (generic SMTP). Default: Gmail with an app password on a dedicated account ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USER=<your-dedicated-gmail-address>
MAIL_PASSWORD=<16-character-app-password-without-spaces>
# The same Gmail address as MAIL_USER.
MAIL_FROM=EstateAI <your-dedicated-gmail-address>
# Later, with your own domain (Brevo): MAIL_HOST=smtp-relay.brevo.com, MAIL_USER and
# MAIL_PASSWORD from Brevo's SMTP settings, MAIL_FROM an address on the verified domain.

# --- AI (optional) ---
AI_PROVIDER=stub
GEMINI_API_KEY=

# Set to true only while you load the sample marketplace, then set it back.
SEED_ALLOWED=false
