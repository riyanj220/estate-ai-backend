# Placeholders only. Run `python3 scripts/bootstrap_env.py` to create an ignored .env
# with generated secrets. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me
DJANGO_BIND_HOST=127.0.0.1
DJANGO_PORT=8000

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=estate_ai
POSTGRES_PASSWORD=change-me
MIGRATOR_USER=migrator
MIGRATOR_PASSWORD=change-me
RUNTIME_USER=runtime
RUNTIME_PASSWORD=change-me

MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_UI_PORT=8025
MAIL_FROM="EstateAI <no-reply@localhost>"
# Local settings refuse any MAIL_HOST that is not loopback. Prod requires MAIL_HOST and MAIL_FROM;
# MAIL_PORT (587), MAIL_USER, MAIL_PASSWORD and MAIL_USE_TLS (true) and MAIL_USE_SSL (false) configure its SMTP server.

# Security baseline. Exact host names and origins only; wildcards are refused.
# Prod requires DJANGO_ALLOWED_HOSTS and an https FRONTEND_BASE_URL with no path.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
# Comma-separated IPs or CIDR ranges of reverse proxies whose X-Forwarded-For is trusted. Empty trusts none.
TRUSTED_PROXIES=
